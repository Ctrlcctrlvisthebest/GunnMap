{
  "name": "gunnmap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:web && node --import tsx web_app.ts",
    "build:web": "tsc --noEmit -p tsconfig.web.json && vite build",
    "build": "tsc && npm run build:web",
    "start": "node dist/web_app.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm run build:web && node --import tsx --test test_*.ts",
    "highlight": "node --import tsx map_cli.ts",
    "map:index": "node --import tsx map_cli.ts --index",
    "map:rebuild": "node --import tsx build_n_map.ts",
    "map:preview": "node --import tsx schedule_preview.ts",
    "map:validate": "node --import tsx n_floor_validation.ts"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@panzoom/panzoom": "^4.6.2",
    "@tarekraafat/autocomplete.js": "^10.2.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
