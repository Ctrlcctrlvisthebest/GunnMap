{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "dist/web",
    "sourceMap": true
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.tsx"]
}
