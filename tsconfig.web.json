{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "rootDir": "web",
    "outDir": "dist/web",
    "sourceMap": true
  },
  "include": ["web/*.ts", "web/*.tsx"]
}
